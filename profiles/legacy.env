# Legacy profile: runs on macOS 10.13+ (Intel) and 11.0+ (Apple Silicon).
# Needs Xcode 26 or older: Xcode 27 refuses deployment targets below macOS 12.
PROFILE_NAME=legacy
XCODE_MAX_MAJOR=26
XCODE_MIN_MAJOR=14
TARGET_X86_64=x86_64-apple-macosx10.13
TARGET_ARM64=arm64-apple-macosx11.0
MIN_SYSTEM=10.13
# Below macOS 10.14.4 the Swift runtime is not part of the OS: copy it into the app.
EMBED_SWIFT_RUNTIME=1
